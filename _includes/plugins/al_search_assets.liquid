
{% al_search_assets %}

<script>
  // Hide selected sections from Ctrl + K search.
  (() => {
    const ninja = document.querySelector("ninja-keys");

    if (!ninja || !Array.isArray(ninja.data)) {
      return;
    }

    const hiddenSections = new Set([
      "books",
      "news",
      "projects",
      "teachings"
    ]);

    ninja.data = ninja.data.filter((item) => {
      const section = String(item.section || "")
        .toLowerCase();

      return !hiddenSections.has(section);
    });
  })();
</script>
